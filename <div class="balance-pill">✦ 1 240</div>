<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gameshop — Донат-магазин</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-0:#0d0710;
    --bg-1:#160c1f;
    --bg-2:#1e1128;
    --pink:#ff4f9e;
    --pink-soft:#ff8fc1;
    --violet:#8b5cf6;
    --gold:#ffd166;
    --text-0:#f6eefb;
    --text-1:#c9b8d6;
    --line:rgba(255,143,193,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 20% -10%, rgba(255,79,158,0.18), transparent 40%),
      radial-gradient(circle at 100% 0%, rgba(139,92,246,0.16), transparent 45%),
      var(--bg-0);
    font-family:'Inter', sans-serif;
    color:var(--text-0);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .app{
    max-width:420px;
    margin:0 auto;
    padding:18px 16px 40px;
  }

  /* header */
  .header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:18px;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .brand-mark{
    width:34px;height:34px;border-radius:10px;
    background:linear-gradient(145deg,var(--pink),var(--violet));
    display:flex;align-items:center;justify-content:center;
    font-family:'Rajdhani',sans-serif;font-weight:700;font-size:16px;
    box-shadow:0 6px 18px rgba(255,79,158,0.35);
  }
  .brand-name{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:19px;letter-spacing:0.3px;}
  .balance-pill{
    display:flex;align-items:center;gap:6px;
    background:var(--bg-2);
    border:1px solid var(--line);
    padding:7px 12px;border-radius:100px;
    font-size:13px;font-weight:600;color:var(--gold);
  }

  .section-title{
    font-size:13px;
    color:var(--text-1);
    text-transform:none;
    margin:22px 2px 10px;
    font-weight:500;
  }

  /* search */
  .search{
    display:flex;align-items:center;gap:8px;
    background:var(--bg-2);
    border:1px solid var(--line);
    border-radius:14px;
    padding:11px 14px;
    color:var(--text-1);
    font-size:14px;
  }
  .search svg{flex-shrink:0;opacity:0.6;}

  /* game cards */
  .games{
    display:flex;
    flex-direction:column;
    gap:12px;
  }
  .card{
    position:relative;
    border-radius:20px;
    height:132px;
    overflow:hidden;
    border:1px solid var(--line);
    isolation:isolate;
    cursor:pointer;
    transition:transform .15s ease;
  }
  .card:active{transform:scale(0.98);}
  .card-art{
    position:absolute; inset:0;
  }
  .card-shade{
    position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(13,7,16,0) 30%, rgba(13,7,16,0.92) 100%);
  }
  .card-body{
    position:absolute; left:16px; right:16px; bottom:13px;
    display:flex; align-items:flex-end; justify-content:space-between;
  }
  .card-title{
    font-family:'Rajdhani',sans-serif;
    font-weight:700;
    font-size:21px;
    letter-spacing:0.5px;
    text-shadow:0 2px 10px rgba(0,0,0,0.5);
  }
  .card-sub{
    font-size:11.5px;
    color:var(--text-1);
    font-weight:500;
    margin-top:2px;
  }
  .card-badge{
    background:rgba(13,7,16,0.55);
    backdrop-filter:blur(6px);
    border:1px solid rgba(255,255,255,0.12);
    color:var(--pink-soft);
    font-size:11px;
    font-weight:600;
    padding:5px 10px;
    border-radius:100px;
    white-space:nowrap;
  }
  .card-top{
    position:absolute; top:12px; left:16px; right:16px;
    display:flex; justify-content:space-between; align-items:flex-start;
  }
  .fire{
    background:rgba(13,7,16,0.55);
    backdrop-filter:blur(6px);
    border:1px solid rgba(255,255,255,0.12);
    padding:4px 9px;
    border-radius:100px;
    font-size:10.5px;
    font-weight:700;
    color:var(--gold);
    display:flex;align-items:center;gap:4px;
  }

  /* individual art backgrounds, original abstract patterns per genre */
  .art-br{ background:
      radial-gradient(circle at 85% 20%, rgba(255,209,102,0.35), transparent 45%),
      linear-gradient(135deg,#3a1f12,#4a2413 40%,#1c1008 100%);
  }
  .art-flame{ background:
      radial-gradient(circle at 15% 15%, rgba(255,79,110,0.4), transparent 50%),
      linear-gradient(135deg,#3a0d16,#5c1424 45%,#170509 100%);
  }
  .art-moba{ background:
      radial-gradient(circle at 80% 80%, rgba(90,200,250,0.35), transparent 50%),
      linear-gradient(135deg,#0d1f3a,#132a4d 45%,#050b17 100%);
  }
  .art-mil{ background:
      radial-gradient(circle at 20% 80%, rgba(160,255,120,0.22), transparent 50%),
      linear-gradient(135deg,#1a2412,#26301a 45%,#0c1008 100%);
  }
  .art-anime{ background:
      radial-gradient(circle at 75% 15%, rgba(255,143,193,0.4), transparent 50%),
      linear-gradient(135deg,#2a0d3a,#3d1150 45%,#12041c 100%);
  }
  .art-steam{ background:
      radial-gradient(circle at 50% 50%, rgba(139,92,246,0.3), transparent 55%),
      linear-gradient(135deg,#141126,#1c1735 45%,#08060f 100%);
  }
  .art-stars{ background:
      radial-gradient(circle at 30% 30%, rgba(255,209,102,0.3), transparent 55%),
      linear-gradient(135deg,#241a10,#2f2313 45%,#0e0a06 100%);
  }

  /* decorative svg wrappers positioned within card-art via absolute */
  .deco{position:absolute; inset:0;}

  .grid2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
  }
  .card.small{height:104px;}
  .card.small .card-title{font-size:17px;}

  .bottom-note{
    text-align:center;
    color:var(--text-1);
    font-size:11.5px;
    margin-top:26px;
    line-height:1.5;
  }
</style>
</head>
<body>
<div class="app">

  <div class="header">
    <div class="brand">
      <div class="brand-mark">G</div>
      <div class="brand-name">Gameshop</div>
    </div>
   
  </div>

  <div class="search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    Найти игру или сервис
  </div>

  <div class="section-title">Популярные пополнения</div>

  <div class="games">

    <!-- PUBG MOBILE -->
    <div class="card">
      <div class="card-art art-br">
        <svg class="deco" viewBox="0 0 400 132" preserveAspectRatio="xMaxYMid slice">
          <polygon points="330,10 400,5 400,60 350,50" fill="rgba(255,209,102,0.10)"/>
          <circle cx="360" cy="35" r="46" fill="none" stroke="rgba(255,209,102,0.25)" stroke-width="1.5"/>
          <circle cx="360" cy="35" r="30" fill="none" stroke="rgba(255,209,102,0.18)" stroke-width="1.5"/>
          <path d="M300 100 L340 70 L380 100 L360 132 L320 132 Z" fill="rgba(255,209,102,0.08)"/>
        </svg>
      </div>
      <div class="card-shade"></div>
      <div class="card-top">
        <span class="fire">🔥 хит</span>
        <span class="card-badge">от 59 ₽</span>
      </div>
      <div class="card-body">
        <div>
          <div class="card-title">PUBG MOBILE</div>
          <div class="card-sub">UC — пополнение баланса</div>
        </div>
      </div>
    </div>

    <!-- Free Fire -->
    <div class="card">
      <div class="card-art art-flame">
        <svg class="deco" viewBox="0 0 400 132" preserveAspectRatio="xMaxYMid slice">
          <path d="M340 20 C355 45 370 55 365 80 C362 100 340 110 330 95 C338 90 340 78 332 70 C320 85 318 100 328 115 C300 110 290 85 300 65 C305 55 315 50 312 38 C325 42 335 30 340 20 Z" fill="rgba(255,79,110,0.28)"/>
          <circle cx="355" cy="30" r="4" fill="rgba(255,209,102,0.5)"/>
        </svg>
      </div>
      <div class="card-shade"></div>
      <div class="card-top">
        <span class="fire">🔥 хит</span>
        <span class="card-badge">от 49 ₽</span>
      </div>
      <div class="card-body">
        <div>
          <div class="card-title">Free Fire</div>
          <div class="card-sub">Алмазы — быстрое пополнение</div>
        </div>
      </div>
    </div>

    <!-- Mobile Legends -->
    <div class="card">
      <div class="card-art art-moba">
        <svg class="deco" viewBox="0 0 400 132" preserveAspectRatio="xMaxYMid slice">
          <polygon points="345,15 385,35 385,80 345,100 305,80 305,35" fill="none" stroke="rgba(120,200,255,0.35)" stroke-width="1.5"/>
          <polygon points="345,32 368,44 368,68 345,80 322,68 322,44" fill="rgba(120,200,255,0.14)"/>
          <line x1="345" y1="15" x2="345" y2="32" stroke="rgba(120,200,255,0.3)" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="card-shade"></div>
      <div class="card-top">
        <span class="card-badge">от 79 ₽</span>
      </div>
      <div class="card-body">
        <div>
          <div class="card-title">Mobile Legends</div>
          <div class="card-sub">Алмазы — Bang Bang</div>
        </div>
      </div>
    </div>

    <!-- Call of Duty Mobile -->
    <div class="card">
      <div class="card-art art-mil">
        <svg class="deco" viewBox="0 0 400 132" preserveAspectRatio="xMaxYMid slice">
          <rect x="300" y="20" width="90" height="8" rx="2" fill="rgba(180,255,120,0.18)" transform="rotate(20 345 24)"/>
          <rect x="290" y="60" width="70" height="6" rx="2" fill="rgba(180,255,120,0.12)" transform="rotate(-10 325 63)"/>
          <circle cx="365" cy="90" r="22" fill="none" stroke="rgba(180,255,120,0.22)" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="card-shade"></div>
      <div class="card-top">
        <span class="card-badge">от 89 ₽</span>
      </div>
      <div class="card-body">
        <div>
          <div class="card-title">Call of Duty Mobile</div>
          <div class="card-sub">CP — игровая валюта</div>
        </div>
      </div>
    </div>

    <!-- Genshin Impact -->
    <div class="card">
      <div class="card-art art-anime">
        <svg class="deco" viewBox="0 0 400 132" preserveAspectRatio="xMaxYMid slice">
          <circle cx="350" cy="45" r="3" fill="rgba(255,209,102,0.6)"/>
          <circle cx="330" cy="70" r="2" fill="rgba(255,209,102,0.5)"/>
          <circle cx="370" cy="85" r="2.5" fill="rgba(255,209,102,0.5)"/>
          <path d="M345 20 L350 32 L362 33 L353 41 L356 53 L345 46 L334 53 L337 41 L328 33 L340 32 Z" fill="rgba(255,209,102,0.35)"/>
        </svg>
      </div>
      <div class="card-shade"></div>
      <div class="card-top">
        <span class="fire">🔥 хит</span>
        <span class="card-badge">от 99 ₽</span>
      </div>
      <div class="card-body">
        <div>
          <div class="card-title">Genshin Impact</div>
          <div class="card-sub">Кристаллы Genesis</div>
        </div>
      </div>
    </div>

  </div>

  <div class="section-title">Другие сервисы</div>

  <div class="card">
    <div class="card-art art-stars"></div>
    <div class="card-shade"></div>
    <div class="card-body">
      <div>
        <div class="card-title">TG Stars</div>
        <div class="card-sub">Звёзды Telegram</div>
      </div>
    </div>
  </div>

  <div class="bottom-note">Все иконки — оригинальная графика.<br>Названия игр указаны для навигации по каталогу.</div>

</div>
</body>
</html>
